generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rank {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  minXp        Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id              String          @id @default(cuid())
  name            String
  location        String
  branchCode      String?         @unique
  externalId      Int?            @unique
  territoryBounds Json?
  dailyReports    DailyReport[]
  flashMissions   FlashMission[]
  missions        Mission[]
  teams           Team[]
  territoryCells  TerritoryCell[]
  users           User[]
  zones           Zone[]
}

model TerritoryCell {
  id           String        @id @default(cuid())
  branchId     String
  code         String
  coordinates  Json
  status       ZoneStatus    @default(UNSEEN)
  label        String?
  row          Int
  col          Int
  missions     Mission[]
  missionTasks MissionTask[]
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
}

model Team {
  id       String  @id @default(cuid())
  name     String
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  users    User[]
}

model User {
  id                 String                      @id @default(cuid())
  name               String
  xp                 Int                         @default(0)
  teamId             String?
  role               Role                        @default(PLAYER)
  branchId           String?
  email              String?                     @unique
  passwordHash       String?
  mustChangePassword Boolean                     @default(false)
  rank               String                      @default("CADET")
  achievements       Achievement[]
  dailyChallenges    DailyChallenge[]
  dailyReports       DailyReport[]
  scoutedLeads       Lead[]
  inductedMerchants  Merchant[]
  approvedTasks      MissionTask[]               @relation("TaskApprover")
  assignedTasks      MissionTask[]               @relation("MissionTaskAssignee")
  notifications      Notification[]
  scratchCards       ScratchCard[]
  branch             Branch?                     @relation(fields: [branchId], references: [id])
  team               Team?                       @relation(fields: [teamId], references: [id])
  flashMissionClaims UserFlashMissionClaim[]
  notificationPrefs  UserNotificationPreference?
  streak             UserStreak?
  ownedZones         Zone[]                      @relation("ZoneOwner")
}

model Zone {
  id            String         @id @default(cuid())
  code          String         @unique
  coordinates   Json
  status        ZoneStatus     @default(UNSEEN)
  ownerId       String?
  branchId      String?
  flashMissions FlashMission[]
  leads         Lead[]
  branch        Branch?        @relation(fields: [branchId], references: [id])
  owner         User?          @relation("ZoneOwner", fields: [ownerId], references: [id])
}

model Lead {
  id              String       @id @default(cuid())
  businessName    String
  category        String
  locationLat     Float
  locationLng     Float
  photoUrl        String?
  status          String       @default("NEW")
  zoneId          String
  scoutedById     String
  estimatedVolume String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  externalBankIds String[]     @default([])
  missionTaskId   String?
  taskReportType  String?
  missionTask     MissionTask? @relation(fields: [missionTaskId], references: [id])
  scoutedBy       User         @relation(fields: [scoutedById], references: [id])
  zone            Zone         @relation(fields: [zoneId], references: [id])
  merchant        Merchant?
}

model Merchant {
  id                    String                    @id @default(cuid())
  leadId                String?                   @unique
  tinNumber             String?
  phoneNumber           String
  onboardingDate        DateTime                  @default(now())
  ownerName             String
  nationalIdNumber      String?
  tradeLicenseNumber    String?
  merchantAccountNumber String
  oathSignatureUrl      String
  citizenNumber         String
  inductedById          String
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  inductedBy            User                      @relation(fields: [inductedById], references: [id])
  lead                  Lead?                     @relation(fields: [leadId], references: [id])
  deploymentAssets      MerchantDeploymentAsset[]
}

model Mission {
  id              String         @id @default(cuid())
  name            String
  status          String         @default("DRAFT")
  branchId        String?
  createdAt       DateTime       @default(now())
  territoryCellId String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  territoryCell   TerritoryCell? @relation(fields: [territoryCellId], references: [id])
  goals           MissionGoal[]
  tasks           MissionTask[]
}

model MissionGoal {
  id          String    @id @default(cuid())
  missionId   String
  title       String
  targetValue Float?
  unit        String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model MissionTask {
  id              String            @id @default(cuid())
  missionId       String
  assigneeId      String
  title           String
  description     String?
  territoryCellId String?
  status          MissionTaskStatus @default(PENDING)
  completionNotes String?
  completedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  taskReportLeads Lead[]
  approvedBy      User?             @relation("TaskApprover", fields: [approvedById], references: [id])
  assignee        User              @relation("MissionTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  mission         Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  territoryCell   TerritoryCell?    @relation(fields: [territoryCellId], references: [id])
}

model DailyReport {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  reportDate DateTime @db.Date
  content    String
  createdAt  DateTime @default(now())
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportDate])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  actorName  String
  branchId   String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model DeploymentAsset {
  id          String                    @id @default(uuid())
  name        String                    @unique
  displayName String
  description String
  briefSteps  String?
  iconUrl     String?
  status      String                    @default("ACTIVE")
  link        String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  merchants   MerchantDeploymentAsset[]
}

model MerchantDeploymentAsset {
  merchantId        String
  deploymentAssetId String
  introducedAt      DateTime        @default(now())
  onboardedAt       DateTime?
  deploymentAsset   DeploymentAsset @relation(fields: [deploymentAssetId], references: [id], onDelete: Cascade)
  merchant          Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, deploymentAssetId])
}

model ScoutCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  iconName     String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  missionId     String?
  missionTaskId String?
  branchId      String?
  seenAt        DateTime?
  createdAt     DateTime  @default(now())
  channel       String    @default("IN_APP")
  metadata      Json?
  priority      String    @default("NORMAL")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seenAt, createdAt])
  @@index([branchId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  type        String
  code        String
  title       String
  description String
  icon        String
  xpReward    Int      @default(0)
  unlockedAt  DateTime @default(now())
  metadata    Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, type])
}

model ScratchCard {
  id          String    @id @default(cuid())
  userId      String
  rewardType  String
  rewardValue Int
  revealed    Boolean   @default(false)
  expiresAt   DateTime
  revealedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revealed, expiresAt])
}

model DailyChallenge {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String
  targetType   String
  targetValue  Int
  currentValue Int       @default(0)
  xpReward     Int
  bonusReward  String?
  date         DateTime  @db.Date
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, title])
  @@index([userId, date])
}

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActionDate DateTime @db.Date
  freezeShields  Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStreak])
}

model FlashMission {
  id            String                  @id @default(cuid())
  zoneId        String?
  branchId      String?
  title         String
  description   String
  xpMultiplier  Float                   @default(1.0)
  bonusReward   Int                     @default(0)
  startsAt      DateTime
  endsAt        DateTime
  maxClaims     Int                     @default(10)
  currentClaims Int                     @default(0)
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  branch        Branch?                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zone          Zone?                   @relation(fields: [zoneId], references: [id])
  claims        UserFlashMissionClaim[]

  @@index([branchId, active, endsAt])
}

model UserFlashMissionClaim {
  id             String       @id @default(cuid())
  flashMissionId String
  userId         String
  claimedAt      DateTime     @default(now())
  completed      Boolean      @default(false)
  completedAt    DateTime?
  flashMission   FlashMission @relation(fields: [flashMissionId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flashMissionId, userId])
  @@index([userId, completed])
}

model UserNotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  motivationType  String   @default("ACHIEVER")
  maxPerDay       Int      @default(5)
  quietHoursStart String   @default("20:00")
  quietHoursEnd   String   @default("07:00")
  channels        Json     @default("{\"IN_APP\": true, \"TELEGRAM\": false, \"WEB_PUSH\": true, \"WHATSAPP\": false}")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExternalBank {
  id   String @id @default(cuid())
  name String @unique
}

model InductionDraft {
  id          String   @id @default(cuid())
  leadId      String
  userId      String
  currentStep Int
  kycFormData Json?
  updatedAt   DateTime @updatedAt

  @@unique([leadId, userId])
}

enum Role {
  PLAYER
  BRANCH_MANAGER
  ADMIN
}

enum ZoneStatus {
  UNSEEN
  SCOUTED
  CAPTURED
  AT_RISK
  FORTIFIED
  LOST
}

enum MissionTaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}
