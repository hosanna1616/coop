# Database
# If Neon pooler is unstable in your network, use direct host for both.
DATABASE_URL="postgresql://postgres:password@localhost:5432/merchant_nation?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/merchant_nation?schema=public"

# Auth (required for login — used to sign session cookies and Edge proxy)
# Set at least one; code prefers JWT_SECRET, else NEXTAUTH_SECRET.
# Vercel: add to Project → Settings → Environment Variables for Production + Preview.
JWT_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps (optional)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Notification system
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NOTIFICATION_SCHEDULER_SECRET="set-a-long-random-secret"
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> — set the same value as NOTIFICATION_SCHEDULER_SECRET
CRON_SECRET="set-a-long-random-secret"

# Email (Resend)
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Merchant Nation <notify@yourdomain.com>"

# Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_BOT_TOKEN="123456789:AA...your-bot-token-from-botfather"
TELEGRAM_WEBHOOK_SECRET_TOKEN="random-string-for-meta-webhook"
# HTTPS URL for inline keyboard buttons (use deployed URL when NEXT_PUBLIC_APP_URL is localhost)
TELEGRAM_LINK_BASE_URL="https://your-app.vercel.app"
# Set only for `npm run telegram:webhook` (production deploy URL)
TELEGRAM_WEBHOOK_BASE_URL="https://your-app.vercel.app"
# npm run dev sets TELEGRAM_LOCAL_POLLING=true and uses long-polling automatically

# Facebook Messenger
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""

# WhatsApp Business
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Web Push gateway (optional external worker endpoint)
PUSH_GATEWAY_URL=""
PUSH_GATEWAY_TOKEN=""
